# Copy to .env and fill in. Used by the frontier-model eval runner (Phase 2).
# Never commit the real .env — it is gitignored.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: Weights & Biases for training curves (used on the GPU box).
WANDB_API_KEY=

# Optional: Hugging Face token for pushing model/dataset (used on the GPU box).
HF_TOKEN=

# Product application. The default replay backend runs one saved sample with no
# external inference call. Production validation rejects replay mode.
UNRENDER_ENV=development
UNRENDER_BASE_URL=http://127.0.0.1:8000
UNRENDER_DATA_DIR=.unrender-data
UNRENDER_EXTRACTOR=replay
UNRENDER_WORKER_ENABLED=true
UNRENDER_ALLOW_REGISTRATION=true
UNRENDER_SEED_DEMO=true
UNRENDER_RETENTION_DAYS=30
UNRENDER_MAX_UPLOAD_BYTES=20971520
UNRENDER_MAX_PDF_PAGES=25
UNRENDER_MAX_USER_STORAGE_BYTES=262144000
UNRENDER_MAX_UNATTACHED_UPLOADS=5
UNRENDER_MAX_UPLOAD_RECORDS_PER_USER=1000
UNRENDER_MAX_JOBS_PER_USER=1000
UNRENDER_MAX_UPLOAD_BYTES_PER_MINUTE=41943040
UNRENDER_RATE_LIMIT_PER_MINUTE=120
UNRENDER_AUTH_RATE_LIMIT_PER_MINUTE=10
UNRENDER_MAX_CONCURRENT_AUTH_REQUESTS=2
UNRENDER_MAX_CONCURRENT_EXPENSIVE_REQUESTS=4
UNRENDER_MAX_RESULT_VERSIONS_PER_JOB=25
UNRENDER_MAX_HISTORY_BYTES_PER_USER=16777216
UNRENDER_MAX_SESSIONS_PER_USER=10
UNRENDER_MAX_ACTIVE_API_KEYS_PER_USER=10
UNRENDER_MAX_API_KEY_RECORDS_PER_USER=100
UNRENDER_MAX_AUDIT_EVENTS_PER_JOB=500
UNRENDER_MAX_AUDIT_EVENTS_PER_USER=5000
UNRENDER_AUDIT_RETENTION_DAYS=90
UNRENDER_MAX_CREDIT_LEDGER_RECORDS_PER_USER=10000
UNRENDER_MAX_DATABASE_ROWS_PER_USER=30000
UNRENDER_MAX_DATABASE_ROWS_GLOBAL=500000
UNRENDER_MAX_BILLING_EVENTS_GLOBAL=100000
UNRENDER_MAX_PROVIDER_ATTEMPTS_PER_JOB=100
UNRENDER_IDEMPOTENCY_TTL_HOURS=720
UNRENDER_IDEMPOTENCY_TOMBSTONE_DAYS=365
UNRENDER_MAX_IDEMPOTENCY_RECORDS_PER_USER=10000

# Modal extraction boundary. The local research path is development-only;
# production requires an approved owner/model repository plus a full commit SHA.
UNRENDER_MODAL_APP=unrender
UNRENDER_MODAL_FUNCTION=infer_one
UNRENDER_MODAL_MODEL=runs/qwen3vl4b-table-fair/merged
UNRENDER_MODAL_REVISION=
UNRENDER_MODAL_MODEL_DIGEST=
UNRENDER_MODAL_PROVIDER_RELEASE=
UNRENDER_MAX_RECOVERY_ATTEMPTS=1
UNRENDER_WORKER_LEASE_SECONDS=45
UNRENDER_WORKER_HEARTBEAT_SECONDS=10
UNRENDER_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
UNRENDER_PROVIDER_FAILURE_LIMIT_PER_USER_HOUR=5
UNRENDER_PROVIDER_FAILURE_LIMIT_GLOBAL_HOUR=50
UNRENDER_RECONCILIATION_GRACE_SECONDS=300

# Optional Stripe test-mode credit pack. The UI reports billing as unavailable
# until all three values are supplied. Never expose these server values to JS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
